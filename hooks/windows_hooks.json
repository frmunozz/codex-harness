{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$HOME/.codex/hooks/run_hook_script.ps1\" rtk_enforce.py",
            "timeout": 5,
            "statusMessage": "Checking RTK shell prefix"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$HOME/.codex/hooks/run_hook_script.ps1\" session_start.py",
            "timeout": 5,
            "statusMessage": "Loading shared Codex guidance"
          }
        ]
      }
    ]
  }
}
