# Portable Codex baseline.
# The install skill reviews and merges these settings into ~/.codex/config.toml.
# The installer script does not replace the user's config file.
# Keep machine-specific paths, MCP commands, project trust entries, and runtime values local.

approval_policy = "on-request"
sandbox_mode = "workspace-write"
personality = "pragmatic"
web_search = "live"
project_doc_max_bytes = 65536

[agents]
max_depth = 1
max_threads = 6

[features]
apps = true
goals = true
hooks = true
multi_agent = true
undo = true
workspace_dependencies = true

[[hooks.SessionStart]]
matcher = "startup|resume|clear|compact"

[[hooks.SessionStart.hooks]]
type = "command"
command = 'bash "$HOME/.codex/hooks/run_hook_script.sh" session_start.py'
command_windows = 'powershell -NoProfile -ExecutionPolicy Bypass -File "$HOME/.codex/hooks/run_hook_script.ps1" session_start.py'
timeout = 5
statusMessage = "Loading exploration guidance"
additionalContextLimit = 1000

[desktop]
followUpQueueMode = "queue"
show-context-window-usage = true

[memories]
generate_memories = false
use_memories = false

# Optional model pin. Leave unset to use the target installation's default.
# model = "gpt-5.6-luna"
# model_reasoning_effort = "xhigh"

# Skills disabled in the source profile. Remove entries to enable them.
[[skills.config]]
enabled = false
name = "build-web-apps:supabase-postgres-best-practices"

[[skills.config]]
enabled = false
name = "build-web-apps:stripe-best-practices"

[[skills.config]]
enabled = false
name = "build-web-apps:shadcn"
